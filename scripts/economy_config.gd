extends Resource
class_name EconomyConfig

## Баланс дневной экономики вынесен в ресурс (.tres) — крутится в инспекторе без правки кода.
## Один ресурс на игру: правишь цифры здесь, меняется везде (зона сдачи, HUD, синглтон Economy).

## Цена за килограмм сданной древесины (валюта/кг). Доход = вес бревна × это. Базовая ручка баланса.
@export var price_per_kg: float = 1.5
## Дневная норма (кг) — МЯГКАЯ цель: прогресс показываем в HUD, но за невыполнение пока не наказываем.
@export var daily_quota_kg: float = 200.0
## Накопительная цель акта (валюта) — деньги на будущую эвакуацию. Пока просто число-ориентир без
## последствий (ни концовки, ни блокировки) — задел, чтобы позже к нему привязать события.
@export var act_evac_goal: float = 5000.0
## Раз в столько дней штабель «вывозят» — складские дрова из загона исчезают (по сюжету за ними
## приезжают, потому деньги и платят). 0 — отключить вывоз. Сбор происходит на старте кратного дня.
@export var collect_interval_days: int = 3
