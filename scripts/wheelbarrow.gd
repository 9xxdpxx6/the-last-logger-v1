extends RigidBody3D
class_name Wheelbarrow

## Двухколёсная ручная грузовая тележка (полная физика): сталкивается с миром, имеет массу/
## инерцию, толкается силой. Груз — НАСТОЯЩИЕ брёвна (FallingLog), лежащие в кузове: едут на
## физике и могут вывалиться на кочке/резком повороте. Грузить — поднести бревно руками и
## положить в кузов (E, глядя на тележку). Доставать — навестись на само бревно и поднять как
## обычно. Толкать/ставить — навестись на раму/ручки и E.
##
## Пока тачку ДЕРЖАТ — сильный момент выравнивания + гашение наклона держат её ровно (иначе с
## грузом переворачивалась). Отпущенная тачка стоит на двух колёсах-цилиндрах и свободно
## наклоняется/падает по физике (как и должна). Колёса — пока greybox-меши; крутятся в _process
## по скорости (вид). Позже заменим визуал на CC0-модель. Узлы: GrabPoint (ручки), CargoAnchor
## (точка засыпки), CargoArea (замер веса), WheelLMesh/WheelRMesh (колёса для прокрутки).

@export_group("Толкание")
## Жёсткость «рук» на ручках: больше — тележка плотнее следует за игроком (меньше «свободный ход»).
## Высокая, чтобы тачка одинаково чётко поспевала и ВПЕРЁД, и НАЗАД (иначе при движении назад
## она отставала, упиралась в поводок и тормозила игрока — назад «ехала хуже», #1).
@export var push_stiffness: float = 90.0
## Гашение в «руках»: гасит рывки/раскачку. Больше — спокойнее.
@export var push_damping: float = 14.0
## Потолок толкающей силы (Н) — тележка не «выстреливает».
@export var push_max_force: float = 40000.0
## На сколько метров ПЕРЕД игроком держатся ручки (длина рук). Коротко — тачка идёт «впритык»
## за игроком, без большого свободного хода.
@export var grab_distance: float = 0.55
## Высота точки рук над origin игрока (м) — примерно на уровне ручек.
@export var grab_height: float = 0.6
## Предел длины рук (м): дальше ручки не отпускаются — тележка упёрлась, игрок встаёт (см. player).
## Маленький — почти нет «свободного хода», тачка жёстко следует за руками (#4: чтобы игрок не
## отходил от ручек и тачка не каталась «сама по себе»).
@export var arm_reach: float = 0.05
## Потолок линейной скорости тележки (м/с) — защита от «выстрела», не ограничитель хода
## (скорость задаёт игрок). Держим выше реальной скорости толкания.
@export var max_push_speed: float = 5.0
## Сила выравнивания «на колёса» (момент на кг): не даёт опрокинуться/лечь набок.
## Высокая — взятая тачка держится ровно даже с грузом (без неё переворачивалась).
@export var upright_strength: float = 120.0
## Выпрямление при взятии (#2): как быстро тачка доворачивается из «на попа»/вверх дном на колёса.
## Угловую скорость задаём ~ угол·right_speed (плавный ease-out), не больше right_max рад/с.
@export var right_speed: float = 4.0
@export var right_max: float = 6.0
## Доля, до которой гасим наклон (крен/тангаж) тачки в руках: 0 — мгновенно ровно,
## 1 — не гасить. Малое значение убирает раскачку/переворот, не трогая доворот (рысканье).
@export var tilt_damp: float = 0.5
## Сила доворота по взгляду (момент на кг). Под грузом доворот слабее — хуже манёвренность.
@export var steer_strength: float = 7.0
## Гашение рысканья (момент на кг·(рад/с)): успокаивает доворот, чтобы при движении прямо тачку
## не водило влево-вправо (раскачка рысканья давала боковой увод, #1). Не путать с tilt_damp (наклон).
@export var steer_damp: float = 3.0

@export_group("Инерция хода")
## Разгон тачки (м/с²): как быстро она набирает ход с места. Меньше — старт «тяжелее», тачка
## разгоняется не мгновенно (есть инерция, #5). Применяется, пока игрок жмёт W/S.
@export var drive_accel: float = 6.0
## Торможение тачки (м/с²): как быстро гаснет ход, когда игрок ОТПУСТИЛ W/S. Меньше — дольше
## катится по инерции. Путь наката ≈ v²/(2·drive_brake): при 4 было ~2 м (тачка «уезжала» почти на
## метр-два после отпускания, #7), при 20 — ~0.4 м: ход всё ещё инертный, но без долгого проката.
@export var drive_brake: float = 20.0
## Угловой разгон доворота (рад/с²): как быстро A/D раскручивают/останавливают поворот тачки.
## Меньше — поворот «набирается» плавно, без щелчка (инерция поворота, #5).
@export var turn_accel: float = 8.0
## Множитель РАЗГОНА на ПОЛНОМ грузе (#H5): гружёная тачка трогается тяжелее. 0.5 — у предела
## загрузки разгон вдвое медленнее, чем у пустой; между ними — пропорционально доле груза.
@export var loaded_accel_mult: float = 0.5
## Множитель ТОРМОЖЕНИЯ на ПОЛНОМ грузе (#H5): чем тяжелее, тем дольше катится по инерции. 0.15 —
## у предела загрузки тормозит в ~6.7 раза слабее пустой → заметно длиннее накат (инерция растёт
## с весом). Путь наката ≈ v²/(2·drive_brake·этот_множитель·доля_груза-лерп).
@export var loaded_brake_mult: float = 0.15

@export_group("Заезд на препятствия")
## Макс. высота уступа (м), на который колёса «вскарабкиваются» на ходу. Иначе тачка едет только по
## ровному и встаёт в любой бордюр (#5). ~40% высоты колеса (диаметр 0.6) ≈ 0.24. Выше — глухой упор.
@export var climb_height: float = 0.24
## Сила «вскарабкивания» как ускорение вверх (м/с²), прикладываемое В ТОЧКЕ упёршегося колеса. Должна
## быть больше g (9.8), иначе не поднимет. Прикладываем к колесу, а не к телу целиком, чтобы тачка
## КРЕНИЛАСЬ, если уступ под одним колесом (#3). Больше — бодрее лезет (и резче кренится).
@export var climb_force: float = 14.0
## Во сколько раз ОСЛАБЛЯЕМ момент выравнивания, пока тачка заезжает на уступ (#3). При заезде
## выравнивание мешает крену — здесь его приглушаем, чтобы тачка могла накрениться (а на большом
## перекосе и завалиться). Вне заезда выравнивание полное (тачку держит ровно). 1.0 — не ослаблять.
@export var climb_upright_mult: float = 0.25
## На сколько вперёд (сверх радиуса колеса) щупаем уступ перед колесом (м). Маленький — реагируем впритык.
@export var climb_probe: float = 0.12
## Мин. скорость хода (м/с), ниже которой не карабкаемся (стоя на месте на уступ не лезем).
@export var climb_min_speed: float = 0.3

@export_group("Расталкивание")
## Тачка в движении расталкивает брёвна легче этого веса (кг). Тяжёлые — упор.
@export var shove_capacity: float = 120.0
## Жёсткость расталкивания (1/с): как резко лёгкое бревно разгоняется до скорости тачки. Сила
## гаснет у цели, поэтому это не постоянный толчок — бревно не уезжает быстрее самой тачки.
@export var shove_accel: float = 8.0

@export_group("Груз")
## Предел загрузки по ВЕСУ (кг): «тяжёлый, но рабочий» максимум. Выше класть нельзя (перегруз).
## Снижен с 250 (#2): замедление/инерция тачки считаются по load_factor = груз / max_load_kg, и при
## пределе 250 реальная загрузка (~70 кг) давала долю ~0.28 — торможение почти не ощущалось. При 120
## те же 70 кг = доля ~0.6, и разница пустой/гружёной читается ясно. Саму логику скорости НЕ трогаем.
@export var max_load_kg: float = 120.0
## Масса пустой тележки (кг). Слегка завышена против реальных 30–40 ради устойчивости груза.
@export var empty_mass: float = 70.0
## Радиус визуального колеса (м) — для прокрутки меша по скорости.
@export var wheel_radius: float = 0.35
## Положение оси колёс вдоль кузова (локальный Z, м). 0 = РОВНО ПОД СЕРЕДИНОЙ кузова (таза): два
## колеса по бокам тачки в её центре (как было раньше). ВАЖНО: в руках центр масс ставим на эту же
## ось — поэтому доворот A/D крутит тачку ровно вокруг колёс без бокового сноса.
## Должно совпадать с Z-позицией колёс в wheelbarrow.tscn (WheelLCol/WheelRCol/WheelLMesh/WheelRMesh).
@export var wheel_axle_z: float = 0.0
## Полуширина зоны укладки бревна по прицелу (м, локальный X кузова). Бревно лежит вдоль кузова, его
## РАДИУС (~0.25–0.3) и так занимает почти всю ширину, поэтому центр держим близко к оси — иначе
## бок бревна протыкает борт (#H1). Малое значение = бревно ставится по центру по ширине. Кузов ~0.34.
@export var cargo_place_half_width: float = 0.08
## Высота спавна бревна над дном кузова (м, #3): кладём ЧУТЬ ВЫШЕ и даём упасть в кузов, иначе
## первое бревно в ПУСТОЙ тачке появлялось у самого дна и толстым телом протыкало дно/борта.
@export var cargo_drop_lift: float = 0.22
## Полудлина зоны укладки по прицелу (м, локальный Z кузова). Прицел зажимается в ±это — бревно
## ложится ближе/дальше вдоль кузова по наводке (#4). Кузов ~0.52.
@export var cargo_place_half_length: float = 0.45
## Макс. отклонение УГЛА укладки бревна от продольной оси кузова (градусы, #H1). 90 = укладка СВОБОДНА
## по направлению взгляда игрока (#3) — как при бросании дров на землю, бревно ложится вдоль угла
## обзора, а не всегда параллельно тачке. Меньше (например 10) — снова прижимали бы строго вдоль кузова.
@export var max_lay_angle: float = 90.0
## Потолок ФИЗИЧЕСКОЙ массы бревна, ПОКА оно в кузове (кг, #I). Корень проваливания сквозь дно —
## разница масс: реальная масса бревна (плотность дерева) в разы больше массы тачки (70 кг), и
## решатель не может удержать такой контакт на тонком дне ДВИЖУЩЕГОСЯ тела — выталкивает бревно вниз.
## Пока бревно лежит в кузове, ограничиваем его физ-массу этим значением: контакт становится
## устойчивым (тоннелинга нет), но бревно остаётся ОБЫЧНЫМ динамическим телом — на кочке подпрыгнет
## и может выпасть, при опрокидывании высыплется. Вышло из кузова — массу возвращаем. ОТОБРАЖАЕМЫЙ
## вес/инерция волока/урон НЕ зависят от этого (они считаются по get_weight, не по mass).
@export var max_cargo_mass: float = 40.0
## НИЖНЯЯ граница физ-массы груза в кузове (кг, #1). Наблюдение: сквозь дно чаще проваливаются ТОНКИЕ/
## КОРОТКИЕ брёвна — у них реальная масса мала (масса ∝ радиус²·длина), и слишком лёгкое тело контакт
## с дном движущейся тачки держит плохо (большой разрыв масс «лёгкий груз ↔ тяжёлая тачка»). Поэтому
## массу груза держим в УЗКОЙ полосе [этого .. max_cargo_mass]: и не слишком тяжёлый (не пробивает дно
## инерцией), и не слишком лёгкий (контакт устойчив). Отображаемый вес/урон не трогаем (они по get_weight).
@export var cargo_min_mass: float = 30.0
## Локальная Y верхней грани дна кузова (м). СТРАХОВОЧНЫЙ зажим (#1) не даёт центру лежащего бревна
## опуститься ниже, чем floor+радиус: даже если решатель попытается протолкнуть бревно сквозь дно —
## мы его возвращаем. ДОЛЖНО совпадать с верхом TubBase в wheelbarrow.tscn (центр 0.35 + полувысота 0.15).
@export var cargo_floor_local_y: float = 0.55
## Макс. длина бревна (м), которое влезает в кузов и грузится (#2). ВРЕМЕННО ОТКЛЮЧЕНО (пробуем без
## ограничения по размеру, #3): большое значение = в тачку кладётся бревно любой длины. Если длинные
## брёвна окажутся неадекватны (торчат/клипают/вываливаются) — вернём сюда реальную длину кузова (~1.3).
@export var max_cargo_length: float = 999.0

var _grabbed: bool = false
## Идёт плавное выпрямление тачки после взятия (#2) и целевая ориентация (только рыскание).
var _righting: bool = false
var _right_quat: Quaternion = Quaternion.IDENTITY
## Отложенный телепорт позиции (применяется в _integrate_forces, #barrow-grab).
var _tp_pending: bool = false
var _tp_origin: Vector3 = Vector3.ZERO
## Командная скорость хода вдоль носа (м/с) и командное рысканье (рад/с): ведём их сами с инерцией,
## не читая обратно linear/angular_velocity, иначе трение груза гасит ход и гружёная тачка стоит (#2).
var _drive_speed: float = 0.0
var _drive_yaw: float = 0.0
## Тачка прямо сейчас заезжает на уступ (climb-assist приложил подъём). Пока true — в drive()
## ослабляем выравнивание и гашение крена, чтобы тачка могла накрениться (#3).
var _climbing: bool = false
## Брёвна, которым мы временно занизили физ-массу, пока они в кузове: log → исходная масса (кг).
## По нему _manage_cargo возвращает массу, когда бревно покидает кузов (см. #I).
var _cargo: Dictionary = {}

@onready var _grab_point: Node3D = $GrabPoint
@onready var _cargo_anchor: Node3D = $CargoAnchor
@onready var _cargo_area: Area3D = $CargoArea
@onready var _wheel_l: Node3D = $WheelLMesh
@onready var _wheel_r: Node3D = $WheelRMesh


func _ready() -> void:
	add_to_group("wheelbarrow")
	mass = empty_mass
	# Сразу «физичная»: центр масс ВЫШЕ оси колёс, поэтому стоящая тачка с самого старта сцены
	# неустойчива на двух колёсах и заваливается — не нужно сперва её трогать (#2). В руках
	# grab() опустит ЦМ на ось (станет устойчивой), release() вернёт высокий.
	center_of_mass = Vector3(0.0, 0.6, 0.1)


func _process(delta: float) -> void:
	# Прокрутка колёс по скорости (чистый визуал). Каждое колесо крутим по СВОЕЙ контактной
	# скорости: v_колеса = linear_velocity + angular_velocity × (точка_колеса − центр), спроецировано
	# на «вперёд» (-Z). На повороте на месте центр почти не едет, но колёса по бокам имеют
	# противоположную скорость от вращения — поэтому они крутятся в РАЗНЫЕ стороны (как в реальности).
	var fwd := -global_transform.basis.z
	_spin_wheel(_wheel_l, fwd, delta)
	_spin_wheel(_wheel_r, fwd, delta)


func _spin_wheel(wheel: Node3D, fwd: Vector3, delta: float) -> void:
	if wheel == null:
		return
	var offset := wheel.global_position - global_position
	var contact_v := linear_velocity + angular_velocity.cross(offset)
	var v := contact_v.dot(fwd)
	var da := v / maxf(wheel_radius, 0.05) * delta
	# Ось качения (цапфа) — локальный Y колеса: цилиндр повёрнут так, что его длинная ось Y
	# лежит горизонтально поперёк хода тачки. Вокруг неё колесо и катится.
	wheel.rotate_object_local(Vector3.UP, da)


## Надёжный ТЕЛЕПОРТ позиции (#barrow-grab): прямой global_position на симулируемом Jolt-теле
## физшаг может проигнорировать, поэтому переносим через _integrate_forces (там transform применяется
## гарантированно). Ориентацию НЕ трогаем — её плавно доводит выпрямление (grab → _righting).
func teleport_to(origin: Vector3) -> void:
	_tp_origin = origin
	_tp_pending = true
	sleeping = false


func _integrate_forces(state: PhysicsDirectBodyState3D) -> void:
	if _tp_pending:
		var xf := state.transform
		xf.origin = _tp_origin
		state.transform = xf
		state.linear_velocity = Vector3.ZERO
		state.angular_velocity = Vector3.ZERO
		_tp_pending = false


func _physics_process(delta: float) -> void:
	# Плавное выпрямление после взятия (#2): доворачиваем корпус к вертикали угловой скоростью ~ угол
	# (ease-out), гравитация сама опускает тачку на колёса. Пока идёт — обычную езду/climb пропускаем.
	if _righting:
		_keep_cargo_awake()
		var cur := global_transform.basis.get_rotation_quaternion()
		var d := (_right_quat * cur.inverse()).normalized()
		if d.w < 0.0:
			d = Quaternion(-d.x, -d.y, -d.z, -d.w)  # кратчайший путь (угол в [0..π])
		var angle := 2.0 * acos(clampf(d.w, -1.0, 1.0))
		var axis := Vector3(d.x, d.y, d.z)
		if angle < deg_to_rad(3.0) or axis.length() < 1e-4:
			_righting = false
			angular_velocity = Vector3.ZERO
		else:
			angular_velocity = axis.normalized() * minf(angle * right_speed, right_max)
		return
	_shove_obstacles()
	_keep_cargo_awake()
	_climb_assist(delta)
	_manage_cargo()
	_contain_cargo()


## Управление физ-массой груза — ЛЕЧЕНИЕ КОРНЯ проваливания сквозь дно (#I). Брёвна в кузове
## остаются ОБЫЧНЫМИ динамическими телами (на кочке подпрыгивают/выпадают, при опрокидывании
## высыпаются), но их ФИЗИЧЕСКУЮ массу мы временно ограничиваем max_cargo_mass: реальная масса
## бревна в разы больше массы тачки (70 кг), и именно эта разница масс ломала контакт на тонком дне
## движущегося тела — решатель проталкивал бревно вниз. С заниженной массой контакт устойчив.
## Бревно ушло из кузова (подняли/выпало/срубили) — возвращаем исходную массу. Отображаемый вес/
## инерция волока/урон не трогаются (они по get_weight, не по mass).
func _manage_cargo() -> void:
	var present := {}
	for b in _cargo_area.get_overlapping_bodies():
		if b is FallingLog:
			present[b] = true
			if not _cargo.has(b):
				_cargo[b] = (b as RigidBody3D).mass
				(b as RigidBody3D).mass = clampf((b as RigidBody3D).mass, cargo_min_mass, max_cargo_mass)
	for log in _cargo.keys():
		if not present.has(log):
			if is_instance_valid(log):
				(log as RigidBody3D).mass = _cargo[log]
			_cargo.erase(log)


## СТРАХОВОЧНЫЙ зажим дна (#1): гарантия, что лежащее в кузове бревно не провалится сквозь дно, что бы
## ни делал решатель. Для каждого груза смотрим его центр В ЛОКАЛЕ тачки: если он опустился ниже, чем
## дно + радиус (то есть бревно лезет сквозь дно) — поднимаем обратно и гасим скорость ВНИЗ относительно
## тачки. Зажим работает ТОЛЬКО вверх — на кочке бревно свободно подпрыгивает и может выскочить за борт.
## ВАЖНО: при сильном крене/перевороте тачки (локальный верх ушёл от мирового вертикали > ~53°) зажим
## ОТКЛЮЧАЕМ — иначе он удерживал бы груз «прилипшим» ко дну, а при опрокидывании он должен ВЫСЫПАТЬСЯ.
func _contain_cargo() -> void:
	var up := global_transform.basis.y
	if up.dot(Vector3.UP) < 0.6:
		return  # тачку завалило — груз держать перестаём, пусть высыпается
	var inv := global_transform.affine_inverse()
	for log in _cargo.keys():
		if not is_instance_valid(log):
			continue
		var fl := log as FallingLog
		var lp := inv * fl.global_position
		var min_y := cargo_floor_local_y + fl.get_radius() + 0.005
		if lp.y >= min_y:
			continue
		lp.y = min_y
		fl.global_position = global_transform * lp
		# Гасим только скорость ВНИЗ относительно тачки (вдоль её локального верха): бревно перестаёт
		# ломиться в дно, но горизонтальный ход/подскок вверх не трогаем.
		var rel := fl.linear_velocity - linear_velocity
		var v_down := rel.dot(up)
		if v_down < 0.0:
			fl.linear_velocity -= up * v_down


## Влезает ли бревно такой длины в кузов (#2). Длиннее — торчало бы за борта/клипало сквозь стенки,
## поэтому в тачку не кладём (игрок такое тащит волоком). Порог — max_cargo_length.
func fits_length(log_length: float) -> bool:
	return log_length <= max_cargo_length


## Заезд колёс на мелкие препятствия (#5). Тачку ведут, ПРЯМО выставляя ей горизонтальную скорость
## (см. drive), поэтому при упоре в бордюр решатель не может сам поднять её вверх — она просто встаёт.
## Здесь от КАЖДОГО колеса щупаем два луча по ходу движения: нижний (у земли) и верхний (на высоте
## climb_height). Если нижний во что-то упёрся, а верхний СВОБОДЕН — значит впереди уступ НИЖЕ
## climb_height: даём тачке вертикальную скорость climb_speed, и колесо «вскарабкивается» на него.
## Высокий уступ перекрывает оба луча → не лезем (остаётся стеной). Стоим/ползём — не карабкаемся.
func _climb_assist(delta: float) -> void:
	var hv := Vector3(linear_velocity.x, 0.0, linear_velocity.z)
	var spd := hv.length()
	if spd < climb_min_speed:
		return
	var travel := hv / spd  # фактическое направление хода (учитывает и движение назад)
	var reach := wheel_radius + climb_probe
	var space := get_world_3d().direct_space_state
	_climbing = false
	# Колёса в локале тачки: x=±0.6, ось по z=wheel_axle_z (0=центр), центр по y=0.35, радиус 0.35 → низ
	# у y=0. КАЖДОЕ колесо обрабатываем НЕЗАВИСИМО: подъём прикладываем силой в точке именно этого
	# колеса, поэтому если уступ только под одним — поднимается одна сторона и тачка КРЕНИТСЯ, а не
	# всплывает целиком (#3). Под обоими колёсами уступ → подъём симметричный, тачка въезжает ровно.
	for wheel_x in [-0.6, 0.6]:
		var center := global_transform * Vector3(wheel_x, 0.35, wheel_axle_z)
		var ground := center.y - wheel_radius
		var low_from := Vector3(center.x, ground + 0.04, center.z)
		var low := _ray(space, low_from, low_from + travel * reach)
		if low.is_empty():
			continue  # перед колесом чисто — катимся как обычно
		# ПОДВИЖНОЕ препятствие (бревно — незамороженный RigidBody) искусственно НЕ переезжаем (#2):
		# climb-assist приподнимал тачку, а бревно при этом откатывалось/проминалось — под колёсами
		# повисал зазор, и тачка «зависала» на бревне. Пусть с подвижным разбирается честная физика:
		# лёгкое расталкивается (_shove_obstacles), на тяжёлое — упор, на стволе/пне (статика) —
		# climb-assist работает как раньше (потому туда «заезжает реалистичнее»).
		var col = low.get("collider")
		if col is RigidBody3D and not (col as RigidBody3D).freeze:
			continue
		# Только КРУТОЙ уступ-стенка (нормаль почти горизонтальна) поднимаем. Пологий склон (нормаль
		# смотрит вверх) НЕ трогаем — по нему тачка едет сама, иначе climb-assist «подбрасывал» её на
		# любом подъёме и под колёсами повисал зазор (#H4).
		var n: Vector3 = low.get("normal", Vector3.UP)
		if n.y > 0.6:
			continue
		var high_from := Vector3(center.x, ground + climb_height + 0.02, center.z)
		var high := _ray(space, high_from, high_from + travel * reach)
		if not high.is_empty():
			continue  # уступ выше climb_height — глухой упор, этим колесом не лезем
		# Уступ ниже climb_height ПОД ЭТИМ колесом: толкаем вверх силой В ТОЧКЕ колеса. Сила вне центра
		# масс даёт и подъём, и момент — сторона с уступом идёт вверх, другое колесо держит землю → крен.
		_climbing = true
		apply_force(Vector3.UP * climb_force * mass, center - global_position)


## Нормаль земли прямо под тачкой (#9.4). Нужна, чтобы вести тачку ВДОЛЬ склона (заезжать на холм),
## а не толкать её строго горизонтально в склон, как в стену. Луч вниз от центра; нет земли (тачка
## в воздухе) → возвращаем строго вверх (UP) = «ровно», тогда вертикаль отдаём гравитации.
func ground_normal() -> Vector3:
	var space := get_world_3d().direct_space_state
	var from := global_position + Vector3.UP * 0.6
	var to := global_position - Vector3.UP * 1.0
	var hit := _ray(space, from, to)
	if hit.is_empty():
		return Vector3.UP
	return hit.get("normal", Vector3.UP)


func _ray(space: PhysicsDirectSpaceState3D, from: Vector3, to: Vector3) -> Dictionary:
	var q := PhysicsRayQueryParameters3D.create(from, to)
	q.exclude = [get_rid()]
	# Те же слои, что и маска тачки (мир/брёвна/препятствия): bits 1,3,5 = 1|4|16 = 21.
	q.collision_mask = 21
	return space.intersect_ray(q)


## Пока тачку везут или она ощутимо движется/наклоняется — НЕ даём грузу заснуть. Спящее бревно
## в кузове перестаёт реагировать на тряску/наклон (кажется «примёрзшим», не вываливается, не
## реагирует на топор — #3). Стоящую/припаркованную тачку не трогаем: груз там спокойно спит.
func _keep_cargo_awake() -> void:
	if not (_grabbed or linear_velocity.length() > 0.2 or angular_velocity.length() > 0.2):
		return
	for b in _cargo_area.get_overlapping_bodies():
		if b is RigidBody3D and not (b as RigidBody3D).freeze:
			(b as RigidBody3D).sleeping = false


## Расталкиваем брёвна, в которые тачка упёрлась на ходу: лёгкие (легче shove_capacity по
## ДИСПЛЕЙНОМУ весу) отлетают с пути, тяжёлые — упор. Так через кучу дров можно проехать, и она
## рассыпется. Брёвна-груз (в кузове) исключаем по CargoArea.
##
## ВАЖНО против «вечного двигателя» (#4): толкаем ТОЛЬКО брёвна ВПЕРЕДИ тачки (по ходу) и НЕ
## быстрее, чем сама тачка едет вперёд. Поэтому энергия в систему не накачивается: как только
## бревно догнало скорость тачки — сила гаснет; стоит игроку перестать толкать, тачка замедляется,
## цель падает, толчок прекращается. Бревно под тачкой (смещение ≈0, dot≤0) не толкаем.
func _shove_obstacles() -> void:
	var fwd := -global_transform.basis.z
	fwd.y = 0.0
	if fwd.length() < 0.01:
		return
	fwd = fwd.normalized()
	var fwd_speed := linear_velocity.dot(fwd)  # скорость именно ВПЕРЁД
	if fwd_speed < 0.3:
		return
	# Брёвна-груз исключаем из расталкивания.
	var cargo := {}
	for b in _cargo_area.get_overlapping_bodies():
		cargo[b] = true
	for body in get_colliding_bodies():
		if not (body is FallingLog) or cargo.has(body):
			continue
		var fl := body as FallingLog
		if fl.freeze:
			continue
		# Только то, что ВПЕРЕДИ по ходу (не под тачкой, не сзади).
		var to_log := fl.global_position - global_position
		to_log.y = 0.0
		if to_log.dot(fwd) <= 0.0:
			continue
		var disp := fl.get_weight()
		if disp > shove_capacity:
			continue
		var k := 1.0 - disp / shove_capacity
		# Цель — не выше скорости самой тачки (потолок энергии) и тем ниже, чем тяжелее бревно.
		var target := fwd_speed * k
		var v_along := fl.linear_velocity.dot(fwd)
		if v_along >= target:
			continue
		fl.sleeping = false
		fl.apply_central_force(fwd * (target - v_along) * shove_accel * fl.mass)


## Мировая точка ручек — за неё «держится» игрок при толкании.
func grab_point_world() -> Vector3:
	return _grab_point.global_position


## РЕЕЛ-ИН (#barrow-reel): игрок держит тачку за ручки. Тянем САМУ ТАЧКУ к рукам ТОЛЬКО когда точка
## хвата ПРОВАЛИЛАСЬ НИЖЕ рук больше чем на slack — т.е. тачка свалилась с уступа/в яму. Триггер именно
## по ВЕРТИКАЛИ, чтобы НЕ мешать обычной езде и подъёму В ГОРКУ (там хват на уровне/выше рук → реел
## молчит, нет дёрганья). hand — мировая позиция рук. Зовётся ПОСЛЕ drive() → выставляем скорость к
## рукам (не импульсом — копился бы); как только подняли (провал ≤ slack), drive/гравитация снова рулят.
func reel_toward(hand: Vector3, gain: float, max_speed: float, slack: float) -> void:
	if not _grabbed or _righting:
		return
	var gp := grab_point_world()
	var drop := hand.y - gp.y  # на сколько хват НИЖЕ рук игрока
	if drop <= slack:
		return
	sleeping = false
	var d := hand - gp  # тянем к рукам (вверх + к игроку) — тачка вылезает из-под уступа
	linear_velocity = d / maxf(d.length(), 0.01) * minf((drop - slack) * gain, max_speed)


## target_yaw (рад) — желаемое рыскание носа после выпрямления. Если задано (игрок «призывает» тачку
## к себе, #barrow-grab), доворачиваем носом по игроку; иначе сохраняем текущее направление носа.
func grab(target_yaw: float = INF) -> void:
	_grabbed = true
	sleeping = false
	# Гасим прежнюю скорость — взяли тачку, она не должна «доезжать» по инерции.
	linear_velocity = Vector3.ZERO
	angular_velocity = Vector3.ZERO
	_drive_speed = 0.0
	_drive_yaw = 0.0
	# В руках центр масс опускаем на ось колёс — низкий ЦМ + момент выравнивания держат тачку
	# ровно даже с грузом. (Раньше тут меняли collision_layer, из-за чего груз проваливался —
	# теперь несталкивание игрока с тачкой делает сам игрок через collision_exception, см. player.)
	center_of_mass = Vector3(0.0, 0.35, wheel_axle_z)
	# ВЫПРЯМЛЯЕМ тачку при взятии (#2): как бы она ни лежала — на боку, НА ПОПА (носом вверх/вниз) или
	# вверх дном — ПЛАВНО доворачиваем её на колёса (не телепорт): запоминаем целевую вертикаль (только
	# рыскание носа по горизонтали), а _physics_process каждый кадр доворачивает к ней угловой скоростью,
	# гравитация при этом сама опускает тачку на колёса. Момент выравнивания в drive() с «попа» не
	# справлялся, поэтому ведём доворот явно, но физикой — выглядит как падение из вертикали на колёса.
	var yaw: float
	if is_finite(target_yaw):
		yaw = target_yaw
	else:
		var fwd := -global_transform.basis.z
		fwd.y = 0.0
		if fwd.length() < 0.01:
			# Нос смотрит вертикально (тачка на попа) — рыскание берём по другой оси корпуса.
			fwd = global_transform.basis.y
			fwd.y = 0.0
		if fwd.length() < 0.01:
			fwd = Vector3.FORWARD
		fwd = fwd.normalized()
		yaw = atan2(-fwd.x, -fwd.z)
	_right_quat = Quaternion(Basis(Vector3.UP, yaw))
	_righting = true
	# Будим груз СРАЗУ при взятии тачки: спящее бревно «примерзает» в кузове и при наклоне/
	# перевороте не вываливается (выглядит как фриз, #6). Разбуженное живёт физикой — выпадет, если
	# тачку опрокинуть. Дальше его держит бодрым _keep_cargo_awake, пока тачку везут/она движется.
	for b in _cargo_area.get_overlapping_bodies():
		if b is RigidBody3D and not (b as RigidBody3D).freeze:
			(b as RigidBody3D).sleeping = false


## Идёт ли сейчас плавное выпрямление после взятия (#2). Игрок по этому НЕ отпускает тачку по
## разрыву поводка, пока она доворачивается (грабпойнт сильно гуляет при довороте на 90°).
func is_righting() -> bool:
	return _righting


func release() -> void:
	_grabbed = false
	# Отпустили до конца выпрямления — прекращаем доворот, дальше тачка живёт обычной физикой.
	_righting = false
	# Поставили тачку — поднимаем центр масс ВЫШЕ оси колёс. На двух колёсах-цилиндрах тачка
	# становится неустойчивой и заваливается вперёд/на ручки (с грузом — в сторону груза), как
	# настоящая двухколёсная тачка, которую отпустили (#6). Лёгкий сдвиг назад (+z) — чаще
	# садится на ручки, удобнее потом снова взять.
	center_of_mass = Vector3(0.0, 0.6, 0.1)
	sleeping = false


## Текущий вес груза (кг) — сумма брёвен, лежащих в зоне кузова прямо сейчас.
func current_load() -> float:
	var total := 0.0
	for b in _cargo_area.get_overlapping_bodies():
		if b is FallingLog:
			total += (b as FallingLog).get_weight()
	return total


## Поместится ли ещё бревно весом extra без перегруза.
func can_load(extra: float) -> bool:
	return current_load() + extra <= max_load_kg


## Перегружена ли тачка (груз сверх max_load_kg). Тогда она ещё ездит, но еле-еле (#2).
func is_overloaded() -> bool:
	return current_load() > max_load_kg


## Доля загрузки 0..1 (игрок по ней замедляется, манёвренность падает).
func load_factor() -> float:
	return clampf(current_load() / maxf(max_load_kg, 0.01), 0.0, 1.0)


## Лежит ли это бревно сейчас В кузове (в зоне CargoArea). Нужно прицелу игрока: когда наводишься
## на бревно, уже лежащее в тачке, действие должно быть «положить в тачку», а не «бросить» (#3).
func contains_cargo(body: Node) -> bool:
	return body in _cargo_area.get_overlapping_bodies()


## Локальная высота верха кузова (точка, на которую целится игрок при укладке). Нужна игроку,
## чтобы спроецировать прицел камеры на «плоскость кузова» и положить бревно ИМЕННО туда (#4).
func cargo_top_y() -> float:
	return _cargo_anchor.global_position.y


## Кладём бревно в кузов: оно становится обычным лежачим телом В тележке (физика, может выпасть).
## Сыпем чуть выше текущей стопки, чтобы упало в кузов, а не вошло в уже лежащие.
##
## aim_point (мировая точка, куда смотрит игрок) задаёт, КУДА вдоль/поперёк кузова лечь бревну —
## так укладка зависит от прицела и положения игрока, а не всегда по центру (#4). Точку зажимаем
## в габариты кузова, чтобы бревно не свешивалось наружу. Если aim_point не задан (бесконечность) —
## кладём по центру, как раньше.
func deposit_log(log: FallingLog, aim_point: Vector3 = Vector3.INF,
		lay_dir: Vector3 = Vector3.INF) -> void:
	var n := 0
	for b in _cargo_area.get_overlapping_bodies():
		if b is FallingLog:
			n += 1
	# Куда лечь ДЛИННОЙ ОСИ бревна: по умолчанию — вдоль носа тачки, но если передали lay_dir (угол
	# подхода игрока) — вдоль него, чтобы укладка зависела от направления игрока к тачке (#4).
	var fwd := lay_dir
	fwd.y = 0.0
	if fwd.length() < 0.01:
		fwd = -global_transform.basis.z
		fwd.y = 0.0
	if fwd.length() < 0.01:
		fwd = Vector3.FORWARD
	fwd = fwd.normalized()
	# Бревно в тачке физически лежит ВДОЛЬ кузова — поперёк/наискосок оно длиной/толщиной торчит за
	# борт (#H1). Поэтому угол укладки от игрока (#4) ЗАЖИМАЕМ к продольной оси тачки: оставляем лишь
	# небольшой разброс (±max_lay_angle), сохраняя «вариативность по наводке», но не давая свешиваться.
	var axis := -global_transform.basis.z
	axis.y = 0.0
	if axis.length() > 0.01:
		axis = axis.normalized()
		var ref := axis if fwd.dot(axis) >= 0.0 else -axis  # ближняя из двух продольных сторон
		var signed := atan2(ref.cross(fwd).y, ref.dot(fwd))   # знаковый угол ref→fwd вокруг вертикали
		signed = clampf(signed, -deg_to_rad(max_lay_angle), deg_to_rad(max_lay_angle))
		fwd = ref.rotated(Vector3.UP, signed)
	# drop() кладёт бревно НИЖНИМ торцом в точку и тянет его вдоль fwd. Чтобы ЦЕНТР бревна попал в
	# нужное место, нижний торец сдвигаем назад на половину длины.
	var half := log.get_length() * 0.5
	# Куда лечь ЦЕНТРУ бревна — берём из прицела (в локале тачки), зажимаем в габариты кузова.
	# По умолчанию (прицел не задан) — центр кузова (локальные X=Z=0).
	var local := Vector3.ZERO
	if aim_point.is_finite():
		local = global_transform.affine_inverse() * aim_point
		local.x = clampf(local.x, -cargo_place_half_width, cargo_place_half_width)
		local.z = clampf(local.z, -cargo_place_half_length, cargo_place_half_length)
	var center := global_transform * Vector3(local.x, 0.0, local.z)
	# Высота укладки: у самого дна кузова, со стопкой по числу уже лежащих брёвен. Кладём низко,
	# чтобы бревно не падало с высоты и не «таранило» дно скоростью. ШАГ стопки = диаметр бревна
	# (2 радиуса) + зазор: при фиксированном шаге 0.32 м (меньше диаметра) брёвна в стопке наезжали
	# друг на друга, и решатель выталкивал их — часть проваливалась/высыпалась. drop() ещё добавит
	# радиус сверху (кладёт поверхностью, не центром), поэтому тут считаем низ каждого «этажа».
	# Базу подняли с −0.10 до +cargo_drop_lift (#3): даже первое бревно в пустой тачке спавнится чуть
	# ВЫШЕ дна и падает в кузов, а не появляется у самого дна и не протыкает его толстым телом.
	center.y = _cargo_anchor.global_position.y + cargo_drop_lift + float(n) * (log.get_radius() * 2.0 + 0.04)
	var pos := center - fwd * half
	# Бревно кладём ОБЫЧНЫМ динамическим телом (паренту — корень сцены): оно живёт честной физикой —
	# на кочке может подпрыгнуть/выпасть, при опрокидывании тачки высыпается. Чтобы при этом оно НЕ
	# проваливалось сквозь дно, лечим истинную причину — РАЗНИЦУ МАСС (#I): реальная масса бревна в
	# разы больше массы тачки, и решатель не удерживал такой контакт на тонком дне движущегося тела.
	# Поэтому сразу занижаем физ-массу бревна (дальше её ведёт _manage_cargo, пока бревно в кузове).
	log.drop(get_tree().current_scene, pos, fwd)
	log.linear_velocity = Vector3.ZERO
	log.angular_velocity = Vector3.ZERO
	log.continuous_cd = true
	log.sleeping = false
	if not _cargo.has(log):
		_cargo[log] = log.mass
		log.mass = clampf(log.mass, cargo_min_mass, max_cargo_mass)


## Ведём тачку НАПРЯМУЮ (barrow-master): ход задаёт игрок клавишами, а мы прямо выставляем
## скорости самой тачки — поэтому НЕТ ни бокового сноса, ни «погони за взглядом», ни зависания
## над склоном (всё это было у старой пружинной модели push_toward).
##  • forward_input ∈[-1..1] (W=+1, S=-1): ход вперёд/назад вдоль СВОЕГО носа. Скорость по модулю
##    симметрична — назад едет ровно так же, как вперёд (#6).
##  • yaw_input ∈[-1..1] (D=+1, A=-1): поворот ВОКРУГ ОСИ КОЛЁС. В руках центр масс стоит ровно на
##    оси колёс — (0, 0.35, wheel_axle_z), это середина отрезка между колёсами по X/Z (см. grab()).
##    Поворот вокруг вертикали через ЦМ держит центр оси колёс НА МЕСТЕ: нос уходит в сторону, тачку
##    вбок НЕ сносит — это и есть «вращение вокруг центра колёсной оси» (#1).
## Скорость по Y НЕ трогаем — ей правит гравитация, поэтому колёса едут по рельефу и на склоне НЕ
## висят в воздухе (#6). Работает и стоя, и в движении: A/D крутят тачку всегда (#3).
func drive(forward_input: float, yaw_input: float, fwd_speed: float, turn_speed: float,
		delta: float) -> void:
	if not _grabbed:
		return
	# Пока тачка ВЫПРЯМЛЯЕТСЯ после взятия (#2) — езду/руление не трогаем, ориентацию ведёт
	# _physics_process; иначе drive() своим выравниванием/рысканьем перебивал бы плавный доворот.
	if _righting:
		return
	sleeping = false
	var fwd := -global_transform.basis.z
	fwd.y = 0.0
	if fwd.length() < 0.01:
		return
	fwd = fwd.normalized()
	# Ход вперёд/назад с ИНЕРЦИЕЙ (#5): ведём СОБСТВЕННУЮ командную скорость _drive_speed (вдоль носа),
	# а не читаем обратно linear_velocity. ВАЖНО (#2): если читать linear_velocity, трение тяжёлого
	# ГРУЗА каждый физшаг гасит её к нулю, прибавка drive_accel·delta «съедается», и гружёная тачка не
	# трогается с места. Команда же копит скорость сама и тащит груз. Жмём W/S — разгон drive_accel;
	# отпустили — торможение drive_brake. ЦМ на оси колёс → перенос вдоль носа без сноса; Y — гравитации.
	var target_speed := forward_input * fwd_speed
	# Инерция растёт с грузом (#H5): по доле загрузки гасим и разгон (тяжело трогается), и торможение
	# (дольше катится). Пустая тачка — как настроено (резвый старт, короткий накат); полная — вязче.
	var lf := load_factor()
	var accel := drive_accel * lerpf(1.0, loaded_accel_mult, lf)
	var brake := drive_brake * lerpf(1.0, loaded_brake_mult, lf)
	var rate := accel if absf(forward_input) > 0.01 else brake
	_drive_speed = move_toward(_drive_speed, target_speed, rate * delta)
	# ХОД ВДОЛЬ СКЛОНА (#9.4): раньше выставляли строго ГОРИЗОНТАЛЬНУЮ скорость (fwd.y=0), а Y отдавали
	# гравитации. На холме это значило «толкать тачку горизонтально в склон» — суммарная скорость
	# смотрела В землю, решатель отбивал тачку назад, и она вставала как у стены (даже пустая) — это и
	# была пропавшая возможность заезжать на холм. Теперь проецируем направление носа на ПЛОСКОСТЬ
	# склона (по нормали земли): на подъёме у скорости появляется +Y и тачка едет ВВЕРХ по склону.
	# Прибавку Y делаем ТОЛЬКО вверх (sv.y>0) — спуск/оседание по-прежнему ведёт гравитация. На ровной
	# земле нормаль = вверх, проекция = тот же fwd, поведение прежнее. Заезд ЗАДОМ работает так же:
	# при S _drive_speed отрицательна, проекция даёт +Y в сторону подъёма (#9.4 «задом в горку»).
	var gn := ground_normal()
	var slope_fwd := fwd - gn * fwd.dot(gn)
	if slope_fwd.length() > 0.01:
		slope_fwd = slope_fwd.normalized()
		var sv := slope_fwd * _drive_speed
		linear_velocity.x = sv.x
		linear_velocity.z = sv.z
		if sv.y > 0.0:
			linear_velocity.y = maxf(linear_velocity.y, sv.y)
	else:
		var v := fwd * _drive_speed
		linear_velocity.x = v.x
		linear_velocity.z = v.z
	# Поворот вокруг оси колёс с инерцией: тоже ведём КОМАНДНОЕ рысканье _drive_yaw (груз гасил бы и
	# его). Крен/тангаж сильно гасим, чтобы тачку не валило.
	_drive_yaw = move_toward(_drive_yaw, -yaw_input * turn_speed, turn_accel * delta)
	var w := angular_velocity
	# Крен/тангаж обычно сильно гасим (тачку не валит). НО при заезде на уступ (#3) почти не гасим —
	# иначе крен от поколёсного подъёма мгновенно «съедается» и тачка снова всплывает ровно.
	var roll_keep := 0.85 if _climbing else 0.2
	w.x *= roll_keep
	w.z *= roll_keep
	w.y = _drive_yaw
	angular_velocity = w
	# Выравнивание «на колёса»: момент возвращает локальный верх к мировому — тачка держится ровно
	# даже с грузом и на склоне (без него заваливалась бы). При заезде на уступ выравнивание
	# ОСЛАБЛЯЕМ (climb_upright_mult), чтобы тачка успевала накрениться (на большом перекосе — завалиться).
	var up := global_transform.basis.y
	var tilt_axis := up.cross(Vector3.UP)
	if tilt_axis.length() > 0.001:
		var us := upright_strength * (climb_upright_mult if _climbing else 1.0)
		apply_torque(tilt_axis * us * mass)
