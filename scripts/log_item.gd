extends Resource
class_name LogItem

## Физические данные древесины вынесены в ресурс (.tres) — крутятся в инспекторе без
## правки кода. «Размер» бревна (длина и средний радиус) превращается тут в «вес». Один
## ресурс на все брёвна: правишь раз — меняется всё. Грузоподъёмность и замедление от веса
## живут на игроке (player.gd), т.к. это свойства лесоруба, а не бревна.

## Плотность СВЕЖЕСРУБЛЕННОЙ древесины (кг/м³). Хвоя/берёза с естественной влажностью
## ~70–80% ≈ 750–900. При 850 полено 1 м диаметром 25–30 см весит ~42–60 кг. ВАЖНО: это
## ФИЗИЧЕСКАЯ масса (удар, инерция, толкание) — её игрок «в руках» не видит, см. ниже.
@export var density: float = 850.0
## Короче этой длины (м) кусок после разруба пропадает (позже на графике — в щепки).
@export var min_length: float = 0.18
## Во сколько раз ОТОБРАЖАЕМЫЙ игроку («рабочий») вес меньше реальной физической массы.
## Зачем: настоящее полено в десятки кг невозможно носить, и менять РЕАЛЬНУЮ массу нельзя —
## это сломает удар/инерцию/толкание. Поэтому физика считает по density, а в HUD и в
## грузоподъёмности (нести/тащить/тачка) идёт вес × этот коэффициент. 0.2 ≈ «в 5 раз легче».
@export var display_weight_scale: float = 0.2


## Физическая масса бревна по его размеру: объём усечённого цилиндра × плотность.
func mass_for(length: float, avg_radius: float) -> float:
	return density * PI * avg_radius * avg_radius * length


## Перевод реальной физической массы (кг) в ОТОБРАЖАЕМЫЙ игроку вес (кг). Единая точка
## конвертации: и HUD, и проверки грузоподъёмности зовут её, физику не трогаем.
func display_weight(physics_mass: float) -> float:
	return physics_mass * display_weight_scale
