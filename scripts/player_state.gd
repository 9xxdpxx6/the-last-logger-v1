extends Node
class_name PlayerState

# База состояния игрока. Конкретные состояния (Idle/Carry/Drag/Barrow) расширяют её и
# реализуют physics_update(). _player — корень сцены (Player): у него живут общие примитивы
# движения (walk_locomotion/_drive_barrow), а состояние лишь решает, какой из них дёрнуть.
#
# (Этап 4a — каркас: состояния пока только маршрутизируют физику. Переходы/ввод/подсказка
#  переедут в состояния позже, под-шаги 4b/4c.)

# owner у узла из player.tscn — корневой Player, поэтому ссылку берём так (а не цепочкой get_parent).
@onready var _player: Player = owner as Player


# Физика этого состояния за кадр. Переопределяется наследниками.
func physics_update(_delta: float) -> void:
	pass


# Текст подсказки под прицелом для этого состояния (без обёртки [center] — её добавит Player).
# Пустая строка = подсказки нет. Переопределяется наследниками.
func prompt_text() -> String:
	return ""


# Контекстное действие E в этом состоянии (взять/положить/бросить и т.п.). Луч прицела уже
# пересчитан вызывающим (Player). Переопределяется наследниками.
func handle_interact() -> void:
	pass
